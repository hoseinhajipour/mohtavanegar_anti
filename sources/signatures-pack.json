{
  "version": "1.0.6",
  "updated_at": "2026-08-09",
  "min_plugin": "1.8.0",
  "signatures": [
    {
      "id": "assert_string_call",
      "label": "فراخوانی assert از رشته ساخته‌شده (obfuscation)",
      "severity": "critical",
      "pattern": "/\\$\\w+\\s*=\\s*['\"]assert['\"]\\s*;[\\s\\S]{0,80}?\\$\\w+\\s*\\(/i",
      "scope": "php",
      "clean": "none"
    },
    {
      "id": "goto_obfuscation",
      "label": "goto اسپگتی (الگوی مبهم‌سازی مدرن)",
      "severity": "warning",
      "pattern": "/\\bgoto\\s+[A-Za-z_]\\w*\\s*;[\\s\\S]{0,200}?\\bgoto\\s+[A-Za-z_]\\w*\\s*;/i",
      "scope": "php",
      "clean": "none"
    },
    {
      "id": "php_filter_include",
      "label": "include با php://filter (استخراج/اجرای کد)",
      "severity": "critical",
      "pattern": "/\\b(?:include|require)(?:_once)?\\s*\\(?\\s*['\"]php:\\/\\/filter\\//i",
      "scope": "php",
      "clean": "statement"
    },
    {
      "id": "array_map_request",
      "label": "array_map/array_walk روی ورودی کاربر (وب‌شل)",
      "severity": "critical",
      "pattern": "/\\b(?:array_map|array_walk|array_filter|usort|uasort)\\s*\\(\\s*['\"](?:assert|system|passthru|shell_exec|exec)['\"]\\s*,\\s*\\$_(?:GET|POST|REQUEST)/i",
      "scope": "php",
      "clean": "none"
    },
    {
      "id": "svg_script_payload",
      "label": "SVG با اسکریپت / event handler مخرب",
      "severity": "warning",
      "pattern": "/<svg[\\s\\S]{0,4000}<(?:script|foreignObject)[\\s>]|<svg[^>]+\\bon(?:load|error|click)\\s*=/i",
      "scope": "svg",
      "clean": "none"
    },
    {
      "id": "ini_auto_prepend",
      "label": "auto_prepend/append در .user.ini یا php.ini",
      "severity": "critical",
      "pattern": "/^\\s*(?:auto_prepend_file|auto_append_file)\\s*=/im",
      "scope": "ini",
      "clean": "none"
    },
    {
      "id": "mailer_bot_markers",
      "label": "نشانه‌های میلر/اسپم‌بات",
      "severity": "warning",
      "pattern": "/\\b(?:mail\\s*\\(\\s*\\$_(?:POST|GET|REQUEST)|PHPMailer.*SMTP.*\\$_(?:POST|GET)|leafmailer|XMailer\\s*:\\s*PHP)/i",
      "scope": "php",
      "clean": "none"
    },
    {
      "id": "wp_cdn_hijack",
      "label": "تزریق CDN/اسکریپت خارجی در هسته قالب/پلاگین",
      "severity": "warning",
      "pattern": "/wp_enqueue_script\\s*\\([^;]*(?:cdn\\.jsdelivr|unpkg\\.com|cdnjs)[^;]*\\$_(?:GET|POST|REQUEST)/i",
      "scope": "php",
      "clean": "none"
    },
    {
      "id": "xdav_tracker_markers",
      "label": "نشانه‌های خانواده xdav-tracker / Fake Cloudflare",
      "severity": "critical",
      "pattern": "/(?:xdav[-_]?tracker|Plugin\\s+Name\\s*:\\s*[^\\n]*xdav|wp-security-helper|Fake\\s+Cloudflare|cloudflare[-_]?verif)/i",
      "scope": "php",
      "clean": "none"
    },
    {
      "id": "zonal_runner_tap_markers",
      "label": "نشانه‌های Zonal Runner Tap / پلاگین جعلی مشابه",
      "severity": "critical",
      "pattern": "/(?:Zonal\\s*Runner\\s*Tap|zonal[-_]?runner[-_]?tap|Plugin\\s+Name\\s*:\\s*[^\\n]*Zonal\\s*Runner)/i",
      "scope": "php",
      "clean": "none"
    },
    {
      "id": "shutdown_js_inject",
      "label": "register_shutdown_function + تزریق JS مبهم (base64/XOR)",
      "severity": "critical",
      "pattern": "/register_shutdown_function\\s*\\([\\s\\S]{0,2500}?(?:base64_decode|gzinflate|str_rot13|\\\\x[0-9a-f]{2})[\\s\\S]{0,1200}?(?:<script|echo\\s+|print\\s+|ob_get|\\$_SERVER\\s*\\[\\s*['\"]REQUEST)/i",
      "scope": "php",
      "clean": "none"
    },
    {
      "id": "hide_plugin_user_hooks",
      "label": "قلاب مخفی‌سازی پلاگین/ادمین (all_plugins + pre_user_query)",
      "severity": "critical",
      "pattern": "/add_(?:filter|action)\\s*\\(\\s*['\"]all_plugins['\"][\\s\\S]{0,800}?add_(?:filter|action)\\s*\\(\\s*['\"](?:pre_user_query|views_users|user_row_actions)['\"]/i",
      "scope": "php",
      "clean": "none"
    },
    {
      "id": "stealth_admin_recreate",
      "label": "بازسازی خودکار ادمین مخفی (wp_insert_user + hide)",
      "severity": "critical",
      "pattern": "/wp_insert_user\\s*\\([\\s\\S]{0,600}?(?:administrator|role['\"]\\s*=>)[\\s\\S]{0,800}?(?:pre_user_query|all_plugins|_pre_user_id)/i",
      "scope": "php",
      "clean": "none"
    }
  ],
  "hashes": []
}
